{
  "name": "@helpdesk/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "worker": "tsx src/jobs/worker.ts",
    "bench": "tsx bench/load.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1137.0",
    "@aws-sdk/s3-request-presigner": "3.1137.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/websocket": "11.3.1",
    "@helpdesk/contracts": "workspace:*",
    "@node-rs/argon2": "2.2.1",
    "bullmq": "6.3.8",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "stripe": "22.6.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/ws": "8.18.1",
    "autocannon": "8.0.0",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "ws": "8.21.3"
  }
}
