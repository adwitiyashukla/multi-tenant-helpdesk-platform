{
  "name": "multi-tenant-helpdesk-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "tsc -p packages/contracts/tsconfig.json",
    "dev": "pnpm --parallel --filter @helpdesk/contracts --filter @helpdesk/api --filter @helpdesk/web dev",
    "build": "pnpm --filter @helpdesk/contracts build && pnpm --filter @helpdesk/api build && pnpm --filter @helpdesk/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm --filter @helpdesk/api test",
    "test:e2e": "pnpm --filter @helpdesk/web test:e2e",
    "db:migrate": "pnpm --filter @helpdesk/api db:migrate",
    "db:seed": "pnpm --filter @helpdesk/api db:seed",
    "bench": "pnpm --filter @helpdesk/api bench"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "typescript": "5.9.3"
  }
}
